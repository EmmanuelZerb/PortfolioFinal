---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CV - Emmanuel Zerbib">
  <div class="cv-container bg-zinc-950 text-zinc-100 min-h-screen p-8 print:p-0">
    <div class="max-w-[210mm] mx-auto bg-zinc-900 shadow-2xl print:shadow-none">
      <!-- Header -->
      <header class="relative overflow-hidden bg-gradient-to-br from-zinc-900 via-zinc-800 to-zinc-900 p-12 print:p-6 print:bg-gradient-to-br print:from-zinc-900 print:via-zinc-800 print:to-zinc-900">
        <div class="relative z-10">
          <div class="flex justify-between items-start gap-8">
            <div class="flex-1">
              <h1 class="text-5xl font-bold mb-2 print:text-3xl">
                EMMANUEL <span class="gradient-text">ZERBIB</span>
              </h1>
              <p class="text-xl text-zinc-400 mb-6 print:text-base">Étudiant Ingénieur · Développeur IA</p>

              <div class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-zinc-400 print:text-xs mb-4">
                <a
                  href="mailto:zerbibemmanuel25@gmail.com"
                  class="flex items-center gap-2 hover:text-zinc-300 transition-colors group"
                >
                  <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
