---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CV - Emmanuel Zerbib">
  <div class="cv-container bg-zinc-950 text-zinc-100 min-h-screen p-4 sm:p-6 md:p-8 print:p-0">
    <!-- Language buttons -->
    <div class="flex justify-center gap-2 sm:gap-3 mb-4 sm:mb-6 print:hidden">
      <button
        id="btn-fr"
        onclick="switchLanguage('fr')"
        class="lang-btn lang-btn-active px-4 py-2 sm:px-6 sm:py-3 rounded-full transition-all duration-300 font-medium border-2 text-sm sm:text-base"
      >
        Français
      </button>
      <button
        id="btn-en"
        onclick="switchLanguage('en')"
        class="lang-btn px-4 py-2 sm:px-6 sm:py-3 rounded-full transition-all duration-300 font-medium border-2 border-zinc-700 hover:border-zinc-500 text-sm sm:text-base"
      >
        English
      </button>
    </div>

    <div class="max-w-full md:max-w-[210mm] mx-auto bg-zinc-900 shadow-2xl print:shadow-none">
      <!-- Header -->
      <header class="relative overflow-hidden bg-gradient-to-br from-zinc-900 via-zinc-800 to-zinc-900 p-4 sm:p-6 md:p-8 lg:p-12 print:p-6 print:bg-gradient-to-br print:from-zinc-900 print:via-zinc-800 print:to-zinc-900">
        <div class="relative z-10">
          <div class="flex flex-col md:flex-row justify-between items-start md:items-start gap-4 md:gap-8">
            <div class="flex-1 w-full">
              <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-2 print:text-3xl">
                EMMANUEL <span class="gradient-text">ZERBIB</span>
              </h1>
              <p class="text-base sm:text-lg md:text-xl text-zinc-400 mb-4 sm:mb-6 print:text-base" data-i18n="subtitle">Étudiant Ingénieur · Développeur IA</p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 sm:gap-x-6 gap-y-2 text-xs sm:text-sm text-zinc-400 print:text-xs mb-4">
                <a
                  href="mailto:zerbibemmanuel25@gmail.com"
                  class="flex items-center gap-2 hover:text-zinc-300 transition-colors group"
                >
                  <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span>zerbibemmanuel25@gmail.com</span>
                </a>

                <a
                  href="https://www.linkedin.com/in/emmanuel-zerbib/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 hover:text-zinc-300 transition-colors group"
                >
                  <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                  <span>in/emmanuel-zerbib</span>
                </a>

                <a
                  href="tel:+33695163524"
                  class="flex items-center gap-2 hover:text-zinc-300 transition-colors group"
                >
                  <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>06 95 16 35 24</span>
                </a>

                <a
                  href="https://github.com/EmmanuelZerb"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 hover:text-zinc-300 transition-colors group"
                >
                  <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                  <span>github.com/EmmanuelZerb</span>
                </a>

                <a
                  href="https://www.google.com/maps/search/?api=1&query=94700+Maisons-Alfort"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 hover:text-zinc-300 transition-colors group sm:col-span-2"
                >
                  <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>94700 Maisons-Alfort</span>
                </a>
              </div>
            </div>

            <!-- QR Code Portfolio -->
            <div class="flex flex-col items-center justify-center gap-2 flex-shrink-0 md:w-auto w-full md:mt-0 mt-4">
              <a
                href="https://ap3gr8.sio1-2lerebours.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="group"
              >
                <div class="p-3 rounded-xl qr-code-container group-hover:scale-105 transition-transform">
                  <img
                    src="/qr-code.png"
                    alt="Portfolio QR Code"
                    class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 print:w-24 print:h-24"
                  />
                </div>
                <p class="text-xs text-zinc-400 text-center font-medium group-hover:text-zinc-300 transition-colors">Portfolio</p>
              </a>
            </div>
          </div>
        </div>
      </header>

      <div class="p-4 sm:p-6 md:p-8 lg:p-12 print:p-6 space-y-4 sm:space-y-6 print:space-y-4">
        <!-- Profil -->
        <section>
          <h2 class="text-xl sm:text-2xl font-bold mb-3 pb-2 border-b-2 border-zinc-700 gradient-text print:text-base print:mb-2" data-i18n="profileTitle">
            PROFIL
          </h2>
          <p class="text-zinc-300 leading-relaxed text-sm sm:text-base print:text-xs" data-i18n="profileText">
            Diplômé d'un BTS SIO SLAM et d'une Licence STS en Informatique, je poursuis
            un cycle ingénieur à l'ECE Paris. Passionné par l'intelligence artificielle,
            les modèles de langage et le développement de solutions innovantes. Actuellement
            en alternance pour développer mes compétences en IA, Big Data et développement logiciel.
          </p>
        </section>

        <!-- Formations -->
        <section>
          <h2 class="text-xl sm:text-2xl font-bold mb-3 pb-2 border-b-2 border-zinc-700 gradient-text print:text-base print:mb-2" data-i18n="formationsTitle">
            FORMATIONS
          </h2>
          <div class="space-y-3 print:space-y-2">
            <div class="glass p-3 rounded-lg print:p-2 flex flex-col sm:flex-row items-start sm:items-center gap-3">
              <img src="/ece-logo.png" alt="ECE Paris" class="w-10 h-10 sm:w-12 sm:h-12 object-contain flex-shrink-0" />
              <div class="flex-1 w-full">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-1 gap-1 sm:gap-0">
                  <h3 class="font-semibold text-sm sm:text-base" data-i18n="edu1Title">Cycle Ingénieur (Majeure DATA - IA)</h3>
                  <span class="text-xs text-zinc-400 font-mono whitespace-nowrap sm:ml-2">2025 - 2028</span>
                </div>
                <p class="text-zinc-400 text-xs sm:text-sm">ECE Paris</p>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2 flex flex-col sm:flex-row items-start sm:items-center gap-3">
              <img src="/cnam-logo.png" alt="CNAM" class="w-10 h-10 sm:w-12 sm:h-12 object-contain flex-shrink-0" />
              <div class="flex-1 w-full">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-1 gap-1 sm:gap-0">
                  <h3 class="font-semibold text-sm sm:text-base" data-i18n="edu2Title">Licence STS</h3>
                  <span class="text-xs text-zinc-400 font-mono whitespace-nowrap sm:ml-2">2024 - 2025</span>
                </div>
                <p class="text-zinc-400 text-xs sm:text-sm" data-i18n="edu2Desc">CNAM - Développement informatique, Intelligence Artificielle et Big Data</p>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2 flex flex-col sm:flex-row items-start sm:items-center gap-3">
              <img src="/rebours-logo.png" alt="Le Rebours" class="w-10 h-10 sm:w-12 sm:h-12 object-contain flex-shrink-0" />
              <div class="flex-1 w-full">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-1 gap-1 sm:gap-0">
                  <h3 class="font-semibold text-sm sm:text-base" data-i18n="edu3Title">BTS SIO SLAM</h3>
                  <span class="text-xs text-zinc-400 font-mono whitespace-nowrap sm:ml-2">2022 - 2024</span>
                </div>
                <p class="text-zinc-400 text-xs sm:text-sm" data-i18n="edu3Desc">Le Rebours - Service Informatique aux Organisations</p>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2 flex flex-col sm:flex-row items-start sm:items-center gap-3">
              <img src="/ort-logo.png" alt="ORT Daniel Mayer" class="w-10 h-10 sm:w-12 sm:h-12 object-contain flex-shrink-0" />
              <div class="flex-1 w-full">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-1 gap-1 sm:gap-0">
                  <h3 class="font-semibold text-sm sm:text-base" data-i18n="edu4Title">Bac Pro Système Numérique</h3>
                  <span class="text-xs text-zinc-400 font-mono whitespace-nowrap sm:ml-2">2019 - 2022</span>
                </div>
                <p class="text-zinc-400 text-xs sm:text-sm" data-i18n="edu4Desc">ORT Daniel Mayer - Mention Bien</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Expériences -->
        <section>
          <h2 class="text-xl sm:text-2xl font-bold mb-3 pb-2 border-b-2 border-zinc-700 gradient-text print:text-base print:mb-2" data-i18n="experiencesTitle">
            EXPÉRIENCES PROFESSIONNELLES
          </h2>
          <div class="space-y-3 print:space-y-2">
            <div class="glass p-3 rounded-lg print:p-2 flex flex-col sm:flex-row items-start gap-3">
              <img src="/mes-potos.png" alt="Mon Ami Poto" class="w-10 h-10 object-contain flex-shrink-0 sm:mt-1" />
              <div class="flex-1 w-full">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-1 gap-1 sm:gap-0">
                  <h3 class="font-semibold text-sm sm:text-base" data-i18n="exp1Title">Développeur LLM</h3>
                  <span class="text-xs text-zinc-400 font-mono whitespace-nowrap sm:ml-2">2024 - 2025</span>
                </div>
                <p class="text-purple-400 mb-1 text-xs sm:text-sm" data-i18n="exp1Company">Mon Ami Poto - Alternance</p>
                <ul class="list-disc list-inside text-zinc-400 text-xs space-y-0.5 print:text-[11px]">
                  <li data-i18n="exp1Task1">Développement d'applications IA en Python</li>
                  <li data-i18n="exp1Task2">Conception et développement d'agents intelligents et assistants virtuels</li>
                  <li data-i18n="exp1Task3">Intégration d'APIs IA et automatisation de workflows conversationnels</li>
                </ul>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2 flex flex-col sm:flex-row items-start gap-3">
              <img src="/opendu17.png" alt="TenniSport - OpenDu17" class="w-10 h-10 object-contain flex-shrink-0 sm:mt-1" />
              <div class="flex-1 w-full">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-1 gap-1 sm:gap-0">
                  <h3 class="font-semibold text-sm sm:text-base" data-i18n="exp2Title">Développeur Web</h3>
                  <span class="text-xs text-zinc-400 font-mono whitespace-nowrap sm:ml-2">2023 - 2024</span>
                </div>
                <p class="text-purple-400 mb-1 text-xs sm:text-sm">TenniSport - OpenDu17</p>
                <ul class="list-disc list-inside text-zinc-400 text-xs space-y-0.5 print:text-[11px]">
                  <li data-i18n="exp2Task1">Maintenance et développement de sites WordPress</li>
                  <li data-i18n="exp2Task2">Analyse des performances avec Google Analytics</li>
                </ul>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2 flex flex-col sm:flex-row items-start gap-3">
              <img src="/rs2i.png" alt="RS2I" class="w-10 h-10 object-contain flex-shrink-0 sm:mt-1" />
              <div class="flex-1 w-full">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-1 gap-1 sm:gap-0">
                  <h3 class="font-semibold text-sm sm:text-base" data-i18n="exp3Title">Assistant Administrateur Systèmes</h3>
                  <span class="text-xs text-zinc-400 font-mono whitespace-nowrap sm:ml-2">2023</span>
                </div>
                <p class="text-purple-400 mb-1 text-xs sm:text-sm">RS2I</p>
                <ul class="list-disc list-inside text-zinc-400 text-xs space-y-0.5 print:text-[11px]">
                  <li data-i18n="exp3Task1">Gestion du serveur PowerEdge R620</li>
                  <li data-i18n="exp3Task2">Déploiement et gestion de machines virtuelles</li>
                  <li data-i18n="exp3Task3">Réinitialisation d'ordinateurs et installation de Windows</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- Compétences -->
        <section>
          <h2 class="text-xl sm:text-2xl font-bold mb-3 pb-2 border-b-2 border-zinc-700 gradient-text print:text-base print:mb-2" data-i18n="competencesTitle">
            COMPÉTENCES
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 print:gap-2">
            <div class="glass p-3 rounded-lg print:p-2">
              <h3 class="font-semibold mb-2 text-sm text-blue-400" data-i18n="skillLanguages">Langages</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Python</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">JavaScript</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Java</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">PHP</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">C++</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">SQL</span>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2">
              <h3 class="font-semibold mb-2 text-sm text-purple-400" data-i18n="skillFrameworks">Frameworks & Libraries</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">React</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">FastAPI</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">LangGraph</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Discord.py</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">JavaFX</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Flutter</span>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2">
              <h3 class="font-semibold mb-2 text-sm text-green-400" data-i18n="skillAI">IA & Data Science</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">OpenAI Platform</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Claude (Anthropic)</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">LangChain</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">RAG</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Agents IA</span>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2">
              <h3 class="font-semibold mb-2 text-sm text-yellow-400" data-i18n="skillUIUX">UI/UX & Styling</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">TailwindCSS</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Bootstrap</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">CSS/SCSS</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3 print:gap-2 print:mt-2">
            <div class="glass p-3 rounded-lg print:p-2">
              <h3 class="font-semibold mb-2 text-sm text-orange-400" data-i18n="skillDatabases">Bases de données</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">MySQL</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">MariaDB</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">SQLite</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">PostgreSQL</span>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2">
              <h3 class="font-semibold mb-2 text-sm text-cyan-400" data-i18n="skillTools">Outils & DevOps</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Git</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Docker</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Linux</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">WordPress</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Langues -->
        <section>
          <h2 class="text-xl sm:text-2xl font-bold mb-3 pb-2 border-b-2 border-zinc-700 gradient-text print:text-base print:mb-2" data-i18n="languesTitle">
            LANGUES
          </h2>
          <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 text-sm">
            <div>
              <span class="font-semibold" data-i18n="langFrench">Français :</span>
              <span class="text-zinc-400" data-i18n="langNative"> Natif</span>
            </div>
            <div>
              <span class="font-semibold" data-i18n="langEnglish">Anglais :</span>
              <span class="text-zinc-400"> B2</span>
            </div>
          </div>
        </section>
      </div>

      <!-- Footer -->
      <footer class="bg-zinc-900 p-4 sm:p-6 text-center text-zinc-500 text-sm print:p-4">
        <p class="text-xs">Développé avec Astro, React & Three.js</p>
      </footer>
    </div>

    <!-- Action buttons -->
    <div class="text-center mt-6 sm:mt-8 px-4 print:hidden">
      <button
        onclick="window.print()"
        class="px-6 py-3 sm:px-8 sm:py-4 bg-blue-600 hover:bg-blue-700 rounded-full transition-all duration-300 inline-flex items-center gap-2 sm:gap-3 font-medium text-base sm:text-lg"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
