          </div>

          <div class="grid grid-cols-2 gap-3 mt-3 print:gap-2 print:mt-2">
            <div class="glass p-3 rounded-lg print:p-2">
              <h3 class="font-semibold mb-2 text-sm text-orange-400">Bases de données</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">MySQL</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">MariaDB</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">SQLite</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">PostgreSQL</span>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2">
              <h3 class="font-semibold mb-2 text-sm text-cyan-400">Outils & DevOps</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Git</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Docker</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">Linux</span>
                <span class="px-2 py-1 text-xs bg-zinc-800 border border-zinc-700 rounded font-mono">WordPress</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Langues -->
        <section>
          <h2 class="text-2xl font-bold mb-3 pb-2 border-b-2 border-zinc-700 gradient-text print:text-base print:mb-2">
            LANGUES
          </h2>
          <div class="flex gap-8 text-sm">
            <div>
              <span class="font-semibold">Français :</span>
              <span class="text-zinc-400"> Natif</span>
            </div>
            <div>
              <span class="font-semibold">Anglais :</span>
              <span class="text-zinc-400"> B2</span>
            </div>
          </div>
        </section>
      </div>

      <!-- Footer -->
      <footer class="bg-zinc-900 p-6 text-center text-zinc-500 text-sm print:p-4">
        <p class="text-xs">Développé avec Astro, React & Three.js</p>
      </footer>
    </div>

    <!-- Action buttons -->
    <div class="text-center mt-8 print:hidden">
      <button
        onclick="window.print()"
        class="px-8 py-4 bg-blue-600 hover:bg-blue-700 rounded-full transition-all duration-300 inline-flex items-center gap-3 font-medium text-lg"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Imprimer / Télécharger PDF</span>
      </button>
      <p class="text-sm text-zinc-500 mt-4">
        Choisissez votre imprimante pour imprimer ou "Enregistrer en PDF" pour télécharger
      </p>
    </div>
  </div>
</Layout>

<style>
  /* Style du QR code avec dégradé gris comme "EMMANUEL ZERBIB" */
  .qr-code-container {
    position: relative;
    display: inline-block;
  }

  .qr-code-container img {
    display: block;
    position: relative;
  }

  .qr-code-container::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, #fafafa 0%, #a1a1aa 100%);
    mask-image: var(--qr-mask);
    -webkit-mask-image: var(--qr-mask);
    mask-size: contain;
    -webkit-mask-size: contain;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    pointer-events: none;
  }

  .qr-code-container img {
    opacity: 0;
  }

  /* Alternative avec opacity sur l'image originale et overlay gradient */
  .qr-code-container {
    background: linear-gradient(to right, #fafafa 0%, #a1a1aa 100%);
    -webkit-mask-image: url('/qr-code.png');
    mask-image: url('/qr-code.png');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  @media print {
    @page {
      size: 210mm 297mm;
      margin: 0;
    }

    * {
      print-color-adjust: exact !important;
      -webkit-print-color-adjust: exact !important;
      color-adjust: exact !important;
    }

    html, body {
      print-color-adjust: exact !important;
      -webkit-print-color-adjust: exact !important;
      margin: 0 !important;
      padding: 0 !important;
      height: 297mm !important;
      overflow: hidden !important;
    }

    .cv-container {
      background: #18181b !important;
      min-height: 0 !important;
      height: 297mm !important;
      max-height: 297mm !important;
      padding: 0 !important;
      margin: 0 !important;
      display: block !important;
      overflow: hidden !important;
    }

    .max-w-\[210mm\] {
      margin: 0 auto !important;
      box-shadow: none !important;
      width: 210mm !important;
      height: 297mm !important;
      max-height: 297mm !important;
      display: block !important;
      overflow: hidden !important;
      transform: scale(0.98);
      transform-origin: top center;
    }

    /* Compacter le header */
    header {
      padding: 0.7rem !important;
    }

    header h1 {
      font-size: 1.5rem !important;
      margin-bottom: 0.25rem !important;
    }

    header p {
      font-size: 0.7rem !important;
      margin-bottom: 0.5rem !important;
    }

    header .grid {
      gap: 0.25rem !important;
      font-size: 0.65rem !important;
    }

    header svg {
      width: 0.75rem !important;
      height: 0.75rem !important;
    }

    /* QR Code */
    .qr-code-container img {
      width: 3.5rem !important;
      height: 3.5rem !important;
    }

    .qr-code-container + p {
      font-size: 0.55rem !important;
    }

    /* Compacter le contenu principal */
    .p-12 {
      padding: 0.6rem !important;
    }

    .space-y-6 {
      gap: 0.38rem !important;
    }

    /* Titres de sections */
    h2 {
      font-size: 0.82rem !important;
      margin-bottom: 0.3rem !important;
      padding-bottom: 0.15rem !important;
