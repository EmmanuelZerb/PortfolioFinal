              <div class="flex-1">
                <div class="flex justify-between items-start mb-1">
                  <h3 class="font-semibold text-base">Licence STS</h3>
                  <span class="text-xs text-zinc-400 font-mono whitespace-nowrap ml-2">2024 - 2025</span>
                </div>
                <p class="text-zinc-400 text-sm">CNAM - Développement informatique, Intelligence Artificielle et Big Data</p>
              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2 flex items-center gap-3">
              <img src="/rebours-logo.png" alt="Le Rebours" class="w-12 h-12 object-contain flex-shrink-0" />
              <div class="flex-1">
                <div class="flex justify-between items-start mb-1">
                  <h3 class="font-semibold text-base">BTS SIO SLAM</h3>
