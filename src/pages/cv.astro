              </div>
            </div>

            <div class="glass p-3 rounded-lg print:p-2 flex items-center gap-3">
              <img src="/ort-logo.png" alt="ORT Daniel Mayer" class="w-12 h-12 object-contain flex-shrink-0" />
              <div class="flex-1">
                <div class="flex justify-between items-start mb-1">
                  <h3 class="font-semibold text-base">Bac Pro Système Numérique</h3>
                  <span class="text-xs text-zinc-400 font-mono whitespace-nowrap ml-2">2019 - 2022</span>
                </div>
